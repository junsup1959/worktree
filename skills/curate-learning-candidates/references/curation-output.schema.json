{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning curation JSONL packet",
  "oneOf": [
    { "$ref": "#/$defs/proposal" },
    { "$ref": "#/$defs/review" }
  ],
  "$defs": {
    "candidateIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "nullableText": { "type": ["string", "null"] },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "proposal_id", "created_at",
        "source_candidate_ids", "disposition", "category", "lesson",
        "applies_when", "procedure", "avoid", "target", "target_skill",
        "requires_verification", "reason"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "record_type": { "const": "proposal" },
        "proposal_id": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "source_candidate_ids": { "$ref": "#/$defs/candidateIds" },
        "disposition": {
          "enum": ["proposed", "rejected", "deferred"]
        },
        "category": {
          "enum": ["skill", "project-guidance", "user-memory", "temporary"]
        },
        "lesson": { "$ref": "#/$defs/nullableText" },
        "applies_when": { "$ref": "#/$defs/nullableText" },
        "procedure": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "target": {
          "enum": [
            "existing-skill", "new-skill", "agents-md",
            "project-reference", "user-memory", "discard"
          ]
        },
        "target_skill": { "$ref": "#/$defs/nullableText" },
        "requires_verification": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "disposition": { "const": "proposed" } } },
          "then": {
            "properties": {
              "lesson": { "type": "string", "minLength": 1 },
              "applies_when": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target": { "enum": ["existing-skill", "new-skill"] }
            }
          },
          "then": {
            "properties": {
              "target_skill": { "type": "string", "minLength": 1 }
            }
          },
          "else": { "properties": { "target_skill": { "const": null } } }
        }
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "record_type", "proposal_id", "status",
        "reviewed_at", "note", "verification"
      ],
      "properties": {
        "schema_version": { "const": 1 },
        "record_type": { "const": "review" },
        "proposal_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["approved", "rejected", "deferred"] },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "note": { "type": "string", "minLength": 1 },
        "verification": { "$ref": "#/$defs/nullableText" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": { "properties": { "verification": { "type": "string", "minLength": 1 } } }
        }
      ]
    }
  }
}
